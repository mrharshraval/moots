datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// =========================================================
// ENUMS
// =========================================================

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
  REMOVED
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  DELETED
  ENDED
  CLOSED
}

enum ConversationKind {
  MATCH
  FRIEND
  GROUP
}

enum ConversationType {
  DIRECT
  GROUP
}

enum GroupRequestType {
  INVITATION
  JOIN_REQUEST
}

enum GroupRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ActorType {
  USER
  GUEST
  BOT
  SUPPORT
  AI
}

enum ParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

// New content types (STICKER, GIF, SYSTEM, ...) are just enum additions
// later - they don't require new tables or a migration of existing rows.
enum ContentType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
}

enum AttachmentType {
  IMAGE
  VIDEO
  AUDIO
  FILE
}

enum ReceiptStatus {
  SENT
  DELIVERED
  READ
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ONGOING
  ENDED
  MISSED
  DECLINED
}

// Scoped to what moderation needs right now (report a message, report a
// person). Reporting a whole conversation is a one-line enum addition
// whenever that's actually needed - no schema restructuring.
enum ReportTargetType {
  MESSAGE
  ACTOR
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum NotificationType {
  NEW_MESSAGE
  MESSAGE_REPLY
  MENTION
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  GROUP_INVITE
  CALL_INVITATION
  MISSED_CALL
  REPORT_UPDATE
  MODERATION_ACTION
  SYSTEM
}

// =========================================================
// AUTH
// =========================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  password      String? // Hashed password
  image         String?
  bio           String?
  lastIp        String?
  userAgent     String?
  lastLoginAt   DateTime?

  // Soft delete: prefer this over hard-deleting a User so that shared
  // conversation history isn't destroyed for other participants. Application
  // code should treat deletedAt != null as "deactivated" and scrub PII fields
  // rather than issuing a real DELETE.
  deletedAt DateTime?

  accounts Account[]
  sessions Session[]
  actors   Actor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =========================================================
// GUEST / ACTOR IDENTITY
// =========================================================

model GuestSession {
  id         String   @id @default(cuid())
  guestToken String   @unique
  deviceId   String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  actors Actor[]

  @@index([expiresAt])
}

model Actor {
  id             String    @id @default(cuid())
  type           ActorType
  userId         String?
  guestSessionId String?
  
  activeMatchConversationId String?
  activeMatchConversation   Conversation? @relation(name: "ActiveMatch", fields: [activeMatchConversationId], references: [id], onDelete: SetNull)

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSession GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)

  // Restrict, not Cascade: forces the app to soft-delete the User (see
  // User.deletedAt) instead of silently deleting participant history when an
  // actor is removed.
  participants Participant[]

  connectionsInitiated Connection[] @relation("ConnectionActor1")
  connectionsReceived  Connection[] @relation("ConnectionActor2")
  devices              Device[]

  messageReceipts  MessageReceipt[]
  callParticipants CallParticipant[]
  createdInvites   GroupInvite[]
  reportsFiled     Report[]          @relation("ReportsFiled")
  notifications    Notification[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([guestSessionId])
  @@index([activeMatchConversationId])
}

model Device {
  id        String   @id @default(cuid())
  actorId   String
  deviceId  String
  platform  String
  pushToken String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([actorId, deviceId])
}

// =========================================================
// CONNECTIONS (contacts / friend graph)
// =========================================================

model Connection {
  id        String           @id @default(cuid())
  // Application code MUST store actor1Id/actor2Id in a canonical order
  // (e.g. lexicographically smaller id first) when creating a row, so that
  // a pair can never end up with two rows in conflicting states
  // (one ACCEPTED, one BLOCKED). The @@unique below only protects a single
  // ordering, not the mirror image.
  actor1Id  String
  actor2Id  String
  status    ConnectionStatus @default(PENDING)
  
  originMatchConversationId String?
  respondedAt               DateTime?
  
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  actor1 Actor @relation("ConnectionActor1", fields: [actor1Id], references: [id], onDelete: Cascade)
  actor2 Actor @relation("ConnectionActor2", fields: [actor2Id], references: [id], onDelete: Cascade)

  @@unique([actor1Id, actor2Id])
  @@index([actor2Id])
  @@index([status])
}

// =========================================================
// CONVERSATIONS
// =========================================================

model Conversation {
  id             String             @id @default(cuid())
  kind           ConversationKind
  type           ConversationType   @default(DIRECT)
  policyId       String             @default("policy_anon_stranger_v1")
  name           String?
  avatarUrl      String?
  status         ConversationStatus @default(ACTIVE)
  endedAt        DateTime?
  expiresAt      DateTime?
  retentionLock  Boolean            @default(false)
  endedByActorId String?

  lastMessageId      String?  @unique
  lastMessagePreview String?
  lastActivityAt     DateTime @default(now())

  policy       Policy        @relation(fields: [policyId], references: [id], onDelete: Restrict)
  lastMessage  Message?      @relation("ConversationLastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)
  participants Participant[]
  messages     Message[]     @relation("ConversationMessages")
  invites      GroupInvite[]
  calls        Call[]
  activeMatchActors Actor[] @relation("ActiveMatch")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastActivityAt])
  @@index([status, expiresAt])
}

model Participant {
  id             String    @id @default(cuid())
  actorId        String
  conversationId String
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?
  hiddenAt       DateTime?

  role ParticipantRole @default(MEMBER)

  // User-specific conversation settings
  persona Persona?

  isPinned          Boolean   @default(false)
  archivedAt        DateTime?
  favoritedAt       DateTime?
  historyClearedAt  DateTime?

  isMuted     Boolean   @default(false)
  mutedUntil  DateTime? // null + isMuted = muted indefinitely
  unreadCount Int       @default(0)
  hasLeft     Boolean   @default(false)

  // Cheap read-cursor for unread badges, separate from the granular
  // per-message MessageReceipt table (which backs "seen by" lists in groups).
  lastReadMessageId String?
  lastReadAt        DateTime?

  actor        Actor        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sentMessages Message[]        @relation("MessageSender")
  receipts     MessageReceipt[]
  reactions    Reaction[]

  @@unique([actorId, conversationId])
  @@index([actorId])
  @@index([conversationId])
}

model Persona {
  id            String   @id @default(cuid())
  participantId String   @unique
  displayName   String   @default("Stranger")
  avatarSeed    String
  color         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

// =========================================================
// MESSAGES
// =========================================================

model Message {
  id             String @id @default(cuid())
  conversationId String

  // Nullable + SetNull: if a participant is removed we keep the message but
  // drop the FK; senderDisplayNameSnapshot preserves who it looked like it
  // was from at send time so history doesn't show a broken reference.
  senderParticipantId       String?
  senderDisplayNameSnapshot String?

  content         String
  contentType     ContentType @default(TEXT)
  clientMessageId String      @unique @default(cuid())

  replyToId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isEdited  Boolean   @default(false)

  // Escape hatch for anything that doesn't yet warrant its own table -
  // e.g. edit history or a link-preview cache can start here and graduate
  // to a dedicated model later without a breaking migration.
  metadata Json?

  conversation Conversation @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Participant? @relation("MessageSender", fields: [senderParticipantId], references: [id], onDelete: SetNull)

  replyTo Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies Message[] @relation("MessageReplies")

  asLastMessageOf Conversation[] @relation("ConversationLastMessage")

  attachments Attachment[]
  reactions   Reaction[]
  receipts    MessageReceipt[]
  reports     Report[]

  @@index([conversationId, createdAt])
  @@index([replyToId])
}

model Attachment {
  id           String         @id @default(cuid())
  messageId    String
  type         AttachmentType
  url          String
  thumbnailUrl String?
  fileName     String?
  mimeType     String?
  sizeBytes    Int?
  width        Int?
  height       Int?
  durationMs   Int?
  createdAt    DateTime       @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Reaction {
  id            String   @id @default(cuid())
  messageId     String
  participantId String
  emoji         String
  createdAt     DateTime @default(now())

  message     Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  // One reaction per (participant, emoji) per message - tapping the same
  // emoji again is a toggle/remove in the app layer.
  @@unique([messageId, participantId, emoji])
  @@index([messageId])
}

// Per-recipient delivery/read tracking. For 1:1 chats this gives WhatsApp-style
// double ticks; for groups it gives a "seen by" list.
model MessageReceipt {
  id            String        @id @default(cuid())
  messageId     String
  participantId String
  actorId       String
  status        ReceiptStatus @default(SENT)
  updatedAt     DateTime      @updatedAt

  message     Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  actor       Actor       @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([messageId, participantId])
  @@index([participantId, status])
}

// =========================================================
// GROUP INVITES
// =========================================================

model GroupInvite {
  id             String    @id @default(cuid())
  conversationId String
  code           String    @unique
  createdById    String
  maxUses        Int?
  useCount       Int       @default(0)
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdBy    Actor        @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model GroupRequest {
  id             String             @id @default(cuid())
  conversationId String
  type           GroupRequestType
  status         GroupRequestStatus @default(PENDING)
  initiatedById  String
  targetActorId  String
  respondedAt    DateTime?
  
  @@unique([conversationId, targetActorId, type, status])
}

// =========================================================
// CALLS
// =========================================================

model Call {
  id             String     @id @default(cuid())
  conversationId String
  type           CallType
  status         CallStatus @default(RINGING)
  startedAt      DateTime   @default(now())
  endedAt        DateTime?

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  participants CallParticipant[]

  @@index([conversationId])
}

model CallParticipant {
  id       String    @id @default(cuid())
  callId   String
  actorId  String
  joinedAt DateTime?
  leftAt   DateTime?

  call  Call  @relation(fields: [callId], references: [id], onDelete: Cascade)
  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([callId, actorId])
}

// =========================================================
// MODERATION
// =========================================================

model Report {
  id         String           @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  messageId  String? // set when targetType = MESSAGE
  reason     String
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  reporter Actor    @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([messageId])
}

// =========================================================
// EVENTS / AUDIT / POLICY
// =========================================================

model DomainEvent {
  id            String    @id @default(cuid())
  eventType     String
  aggregateId   String
  aggregateType String
  payload       Json
  publishedAt   DateTime?
  occurredAt    DateTime  @default(now())

  @@index([publishedAt])
  @@index([occurredAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  event      String
  metadata   Json
  ip         String?
  occurredAt DateTime @default(now())

  // Intentionally NOT a relation to Actor: audit logs should survive actor
  // deletion for compliance/forensics, so this stays a loose reference by
  // design rather than an oversight.
  @@index([actorId])
  @@index([occurredAt])
}

model Policy {
  id          String   @id @default(cuid())
  name        String
  description String?
  rules       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversations Conversation[]
}

// =========================================================
// NOTIFICATIONS
// =========================================================

model Notification {
  id      String           @id @default(cuid())
  actorId String
  type    NotificationType

  // Optional reference to the underlying entity
  entityId String?

  // Unique key to prevent duplicate notifications for the same event
  idempotencyKey String?

  // Flexible payload for rendering details (e.g. senderName, messagePreview)
  payload Json

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([actorId, idempotencyKey])
  @@index([actorId, isRead])
  @@index([createdAt])
}
