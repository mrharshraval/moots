# Port number for the WebSocket server
PORT=3001

# Comma-separated list of allowed origins for CORS/WS origin validation
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,https://moots.in,https://www.moots.in,https://ws.moots.in

# Secret for verifying JWT access tokens (Must match API server)
JWT_SECRET=

# Secret for internal microservice communication (Must match API server)
INTERNAL_SERVICE_KEY=
